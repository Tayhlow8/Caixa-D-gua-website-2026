{
  "$schema": "https://raw.githubusercontent.com/token-studio/schemas/main/schema.json",
  "global": {
    "color": {
      "navy-deep":   { "value": "#0D2A52", "$type": "color" },
      "navy":        { "value": "#1A4A8A", "$type": "color" },
      "navy-mid":    { "value": "#1657A8", "$type": "color" },
      "cobalt":      { "value": "#1A6BC4", "$type": "color" },
      "royal":       { "value": "#1E90E8", "$type": "color" },
      "sky":         { "value": "#00B8F0", "$type": "color" },
      "cyan":        { "value": "#00C8F0", "$type": "color" },
      "cyan-light":  { "value": "#7ADCF5", "$type": "color" },
      "cyan-pale":   { "value": "#C6F0FB", "$type": "color" },
      "cyan-ghost":  { "value": "#E0F6FD", "$type": "color" },
      "lacre":       { "value": "#00D4AA", "$type": "color" },
      "lacre-light": { "value": "#CCFAF0", "$type": "color" },
      "white":       { "value": "#FFFFFF", "$type": "color" },
      "fog":         { "value": "#F2F6FB", "$type": "color" },
      "mist":        { "value": "#DDE8F5", "$type": "color" },
      "iron":        { "value": "#6B82A0", "$type": "color" },
      "steel":       { "value": "#3A5270", "$type": "color" },
      "text":        { "value": "#0A1E35", "$type": "color" },
      "success":     { "value": "#00D4AA", "$type": "color" },
      "warning":     { "value": "#E8A020", "$type": "color" },
      "error":       { "value": "#D64045", "$type": "color" },
      "wpp":         { "value": "#075E54", "$type": "color" },
      "wpp-hover":   { "value": "#25D366", "$type": "color" }
    },
    "font": {
      "display": { "value": "'Syne', sans-serif",    "$type": "fontFamily" },
      "body":    { "value": "'Lato', sans-serif",     "$type": "fontFamily" },
      "mono":    { "value": "'DM Mono', monospace",   "$type": "fontFamily" }
    },
    "fontSize": {
      "xs":      { "value": "10px",                  "$type": "dimension" },
      "sm":      { "value": "12px",                  "$type": "dimension" },
      "base":    { "value": "15px",                  "$type": "dimension" },
      "md":      { "value": "16px",                  "$type": "dimension" },
      "lg":      { "value": "18px",                  "$type": "dimension" },
      "xl":      { "value": "22px",                  "$type": "dimension" },
      "2xl":     { "value": "28px",                  "$type": "dimension" },
      "3xl":     { "value": "36px",                  "$type": "dimension" }
    },
    "fontWeight": {
      "light":   { "value": "300",                   "$type": "fontWeight" },
      "regular": { "value": "400",                   "$type": "fontWeight" },
      "bold":    { "value": "700",                   "$type": "fontWeight" },
      "black":   { "value": "800",                   "$type": "fontWeight" }
    },
    "spacing": {
      "1":  { "value": "4px",   "$type": "dimension" },
      "2":  { "value": "8px",   "$type": "dimension" },
      "3":  { "value": "12px",  "$type": "dimension" },
      "4":  { "value": "16px",  "$type": "dimension" },
      "5":  { "value": "20px",  "$type": "dimension" },
      "6":  { "value": "24px",  "$type": "dimension" },
      "8":  { "value": "32px",  "$type": "dimension" },
      "10": { "value": "40px",  "$type": "dimension" },
      "12": { "value": "48px",  "$type": "dimension" },
      "16": { "value": "64px",  "$type": "dimension" },
      "20": { "value": "80px",  "$type": "dimension" },
      "24": { "value": "96px",  "$type": "dimension" }
    },
    "borderRadius": {
      "none": { "value": "0px",    "$type": "dimension" },
      "xs":   { "value": "2px",    "$type": "dimension" },
      "sm":   { "value": "4px",    "$type": "dimension" },
      "md":   { "value": "8px",    "$type": "dimension" },
      "pill": { "value": "999px",  "$type": "dimension" }
    },
    "duration": {
      "instant": { "value": "80ms",  "$type": "duration" },
      "fast":    { "value": "150ms", "$type": "duration" },
      "base":    { "value": "280ms", "$type": "duration" },
      "slow":    { "value": "500ms", "$type": "duration" },
      "enter":   { "value": "700ms", "$type": "duration" }
    }
  },
  "semantic": {
    "color": {
      "brand": {
        "primary":   { "value": "{global.color.navy}",      "$type": "color" },
        "deep":      { "value": "{global.color.navy-deep}",  "$type": "color" },
        "accent":    { "value": "{global.color.sky}",        "$type": "color" },
        "highlight": { "value": "{global.color.cyan}",       "$type": "color" },
        "success":   { "value": "{global.color.lacre}",      "$type": "color" }
      },
      "bg": {
        "page":    { "value": "{global.color.fog}",   "$type": "color" },
        "surface": { "value": "{global.color.white}",  "$type": "color" },
        "hero":    { "value": "{global.color.navy-deep}", "$type": "color" }
      },
      "text": {
        "primary":   { "value": "{global.color.text}",  "$type": "color" },
        "secondary": { "value": "{global.color.steel}", "$type": "color" },
        "muted":     { "value": "{global.color.iron}",  "$type": "color" },
        "on-dark":   { "value": "{global.color.white}", "$type": "color" },
        "on-accent": { "value": "{global.color.navy-deep}", "$type": "color" }
      },
      "border": {
        "default":  { "value": "{global.color.mist}",  "$type": "color" },
        "emphasis": { "value": "{global.color.navy}",  "$type": "color" },
        "accent":   { "value": "{global.color.sky}",   "$type": "color" }
      }
    }
  }
}
